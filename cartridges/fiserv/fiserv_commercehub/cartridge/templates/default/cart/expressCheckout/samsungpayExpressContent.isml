<isset name="FiservConstants" value="${require('*/cartridge/fiservConstants/constants')}" scope="pdict" />
<isset name="FiservFrontendConfigRetriever" value="${require('*/cartridge/scripts/utils/commercehubFrontendInitializationData')}" scope="pdict" />

<isscript>
    var samsungpayInitData = pdict.FiservFrontendConfigRetriever.retrieveFrontendInitializationData('SamsungPay');

    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-helper.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-button-adapter.js');
    assets.addJs('/js/fiserv_samsungpay/commercehub-samsungpay-handler-template.js');
    assets.addJs('/js/fiserv_samsungpay/commercehub-samsungpay-button-base.js');
    assets.addJs('/js/fiserv_samsungpay/samsungpay.js');
    assets.addJs(pdict.FiservConstants.COMMERCEHUB_SDK_URL);
    assets.addCss('css/fiservScc.css');
</isscript>


<div class="tab-pane samsungpay-content" id="samsungpay-content">
    <div id="fiserv-commercehub-samsungpay-form-init-container"
        data-commercehub-initialization-data="${JSON.stringify(samsungpayInitData)}"
        data-commercehub-credentials="${URLUtils.https('Fiserv-Credentials')}"
        data-payment-amount-block=".grand-total"></div>

    <div id="fiserv_commercehub-samsungpay-button" class="sdc-button"></div>

    <div id="fiserv-samsungpay-fatal-notice" class="alert alert-danger">
        <p>${Resource.msg('message.error.samsungpay.fatal','error',null)}</p>
    </div>

    <!--- Hidden input for session ID --->
    <input id="commercehubSessionIdInputSamsungPay" type="hidden" name="<<< ADD IN FORM ITEM ROUTING HERE >>>"/>
</div>
