<isset name="FiservConstants" value="${require('*/cartridge/fiservConstants/constants')}" scope="pdict" />
<isset name="FiservFrontendConfigRetriever" value="${require('*/cartridge/scripts/utils/commercehubFrontendInitializationData')}" scope="pdict" />

<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-helper.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-button-adapter.js');
    assets.addJs('/js/fiserv_paze/commercehub-paze-handler-template.js');
    assets.addJs('/js/fiserv_paze/commercehub-paze-button-base.js');
    assets.addJs('/js/fiserv_paze/paze.js');
    assets.addJs(pdict.FiservConstants.COMMERCEHUB_SDK_URL);
    assets.addCss('css/fiservScc.css');
</isscript>


<div class="tab-pane paze-content" id="paze-content">
    <div id="fiserv-commercehub-paze-form-init-container"
        data-commercehub-initialization-data="${JSON.stringify(pdict.FiservFrontendConfigRetriever.retrieveFrontendInitializationData('Paze'))}"
        data-commercehub-credentials="${URLUtils.https('Fiserv-Credentials')}"
        data-order-details-url="${URLUtils.https('Fiserv-OrderDetails')}"
        data-payment-amount-block=".grand-total"></div>

    <div id="fiserv_commercehub-paze-button" class="sdc-button"></div>

    <div id="fiserv-paze-fatal-notice" class="alert alert-danger">
        <p>${Resource.msg('message.error.paze.fatal','error',null)}</p>
    </div>

    <!--- Hidden input for session ID --->
    <input id="commercehubSessionIdInputPaze" type="hidden" name="<<< ADD IN FORM ITEM ROUTING HERE >>>"/>
</div>
