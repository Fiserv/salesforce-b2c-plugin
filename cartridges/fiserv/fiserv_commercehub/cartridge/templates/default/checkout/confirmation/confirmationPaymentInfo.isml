<iscomment>
    This template is created to render payment information in the order confirmation email.
</iscomment>
<isloop items="${pdict.order.billing.payment.selectedPaymentInstruments}" var="payment">
    <isif condition="${payment.paymentMethod === 'CREDIT_CARD'}">
        <div>
            <span>${Resource.msg('msg.payment.type.credit', 'confirmation', null)}
                ${payment.type}</span>
        </div>
        <div>
            ${payment.maskedCreditCardNumber}
        </div>
        <div>
            <span>${Resource.msg('msg.card.type.ending', 'confirmation', null)} ${payment.expirationMonth}/${payment.expirationYear}</span>
        </div>
    <iselseif condition="${payment.paymentMethod === 'ACH'}" />
        <div class="ach-item">
            <span>ACH</span>
        </div>
    <iselseif condition="${payment.paymentMethod === 'GIFT_CARD'}" />
        <div class="gift-card-item">
            <span>${Resource.msg('display.html.gift.giftListItem', 'display', null)} - ${payment.currencySymbol}${payment.amount}</span>
        </div>
    <iselseif condition="${payment.paymentMethod === 'PAYPAL'}" />
        <div class="paypal-item">
            <span>PayPal</span>
        </div>
        <iselseif condition="${payment.paymentMethod === 'VENMO'}" />
        <div class="venmo-item">
            <span>Venmo</span>
        </div>
    <iselseif condition="${payment.paymentMethod === 'APPLEPAY'}" />
        <div class="applepay-item">
            <span>Apple Pay</span>
        </div>
    <iselseif condition="${payment.paymentMethod === 'SAMSUNGPAY'}" />
        <div class="samsungpay-item">
            <span>Samsung Pay</span>
        </div>
    <iselseif condition="${payment.paymentMethod === 'AFFIRM'}" />
        <div class="affirm-item">
            <span>Affirm</span>
        </div>
    </isif>
</isloop>
