<isset name="FiservConstants" value="${require('*/cartridge/fiservConstants/constants')}" scope="pdict" />
<isset name="FiservFrontendConfigRetriever" value="${require('*/cartridge/scripts/utils/commercehubFrontendInitializationData')}" scope="pdict" />

<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-helper.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-iframe-adapter.js');
    assets.addJs('/js/fiserv_base/commercehub-dom-disable-handler.js');
    assets.addJs('/js/fiserv_ach/commercehub-ach-form.js');
    assets.addJs('/js/fiserv_ach/ach.js');
    assets.addJs(pdict.FiservConstants.COMMERCEHUB_SDK_URL);
    assets.addCss('css/fiservScc.css');
</isscript>

<div class="tab-pane ach-content" id="ach-content" role="tabpanel">

    <fieldset class="payment-form-fields">

        <!--- payment method is ACH --->
        <input type="hidden" class="form-control"
               name="${pdict.forms.billingForm.paymentMethod.htmlName}"
               value="ACH"
        >

        <div id="fiserv-commercehub-ach-form-init-container"
            data-commercehub-initialization-data="${JSON.stringify(pdict.FiservFrontendConfigRetriever.retrieveFrontendInitializationData('ACH'))}"
            data-commercehub-credentials="${URLUtils.https('Fiserv-Credentials')}"
            data-initial-checkout-stage="${pdict.currentStage}"></div>

        <div id="fiserv-commercehub-ach-form-container">
            <div class="sdc-column">
                <div class="sdc-row">
                    <div id="sdc-account-type-frame" class="sdc-field-frame sdc-dropdown">
                        <div id="fiserv_commercehub-ach-account-type" class="sdc-field"></div>
                    </div>
                    <span id="sdc-account-type-invalid-message" class="sdc-error-message sdc-hidden"></span>
                </div>
                <div class="sdc-row">
                    <div id="sdc-check-type-frame" class="sdc-field-frame sdc-dropdown">
                        <div id="fiserv_commercehub-ach-check-type" class="sdc-field"></div>
                    </div>
                    <span id="sdc-check-type-invalid-message" class="sdc-error-message sdc-hidden"></span>
                </div>
            </div>
            <div class="sdc-row">
                <div id="sdc-business-name-frame" class="sdc-field-frame sdc-text">
                    <div id="fiserv_commercehub-ach-business-name" class="sdc-field"></div>
                </div>
                <span id="sdc-business-name-invalid-message" class="sdc-error-message sdc-hidden"></span>
            </div>
            <div class="sdc-row">
                <div id="sdc-account-number-frame" class="sdc-field-frame sdc-text">
                    <div id="fiserv_commercehub-ach-account-number" class="sdc-field"></div>
                    <button id="sdc-mask-accountNumber" class="btn sdc-unmasking-icon"></button>
                </div>
                <span id="sdc-account-number-invalid-message" class="sdc-error-message sdc-hidden"></span>
            </div>
            <div class="sdc-row">
                <div id="sdc-routing-number-frame" class="sdc-field-frame sdc-text">
                    <div id="fiserv_commercehub-ach-routing-number" class="sdc-field"></div>
                    <button id="sdc-mask-routingNumber" class="btn sdc-unmasking-icon"></button>
                </div>
                <span id="sdc-routing-number-invalid-message" class="sdc-error-message sdc-hidden"></span>
            </div>
            <div class="sdc-column">
                <div class="sdc-row">
                    <div id="sdc-id-type-frame" class="sdc-field-frame sdc-dropdown">
                        <div id="fiserv_commercehub-ach-id-type" class="sdc-field"></div>
                    </div>
                    <span id="sdc-id-type-invalid-message" class="sdc-error-message sdc-hidden"></span>
                </div>
                <div class="sdc-row">
                    <div id="sdc-driver-license-state-frame" class="sdc-field-frame sdc-dropdown">
                        <div id="fiserv_commercehub-ach-driver-license-state" class="sdc-field"></div>
                    </div>
                    <span id="sdc-driver-license-state-invalid-message" class="sdc-error-message sdc-hidden"></span>
                </div>
            </div>
            <div class="sdc-row">
                <div id="sdc-id-value-frame" class="sdc-field-frame sdc-text">
                    <div id="fiserv_commercehub-ach-id-value" class="sdc-field"></div>
                </div>
                <span id="sdc-id-value-invalid-message" class="sdc-error-message sdc-hidden"></span>
            </div>

            <div id="fiserv-ach-confirm-fields-container" style="display:none;">
                <button id="fiserv-ach-confirm-fields-btn" class="btn btn-primary btn-block">
                    ${Resource.msg('display.ach.confirmFields', 'display', null)}
                </button>
            </div>

            <div class="privacyPolicy">
                <span></span>
                Payments Powered by Fiserv.&nbsp; <a target="_blank" href="https://www.fiserv.com/privacy">Privacy Notice</a>.
            </div>
            <div id="fiserv-ach-fatal-notice" class="alert alert-danger">
                <p>${Resource.msg('message.error.scc.fatal','error',null)}</p>
            </div>
        </div>

        <div id="fiserv-ach-legal-text-container" style="display:none;">
            <div id="fiserv-ach-legal-text-box" class="fiserv-ach-legal-text-box">
                <div id="fiserv-ach-legal-text"></div>
            </div>
            <div class="ach-legal-accept custom-control custom-checkbox">
                <input type="checkbox" id="achConsentIndicator" class="custom-control-input" name="${pdict.forms.billingForm.fiservCommercehubPaymentFields.achConsentIndicator.htmlName}" value="true">
                <label class="custom-control-label" for="achConsentIndicator">
                    ${Resource.msg('display.ach.legal.accept', 'display', null)}
                </label>
            </div>
        </div>

        <!--- Hidden input for session ID --->
        <input id="commercehubSessionIdInputACH" type="hidden" name="${pdict.forms.billingForm.fiservCommercehubPaymentFields.commercehubSessionId.htmlName}"/>

        <iscomment> This field needs to be here when Credit Card is not enabled </iscomment>
        <isif condition="${!pdict.FiservConfig.getCommerceHubCreditEnabled()}">
            <input type="hidden" class="form-control cardNumber" id="cardNumber" value="" <isprint value=${pdict.forms.billingForm.creditCardFields.cardNumber.attributes} encoding="off"/>/>
        </isif>

    </fieldset>
</div>
