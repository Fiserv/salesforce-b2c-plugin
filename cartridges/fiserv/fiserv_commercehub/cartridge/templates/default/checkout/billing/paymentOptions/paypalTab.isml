<li class="nav-item ${pdict.firstActivePaymentMethod === 'PAYPAL' ? 'active' : ''}" data-method-id="${paymentOption.ID}">
    <a class="nav-link paypal-tab ${pdict.firstActivePaymentMethod === 'PAYPAL' ? 'active' : ''}" data-toggle="tab" href="#paypal-content" role="tab">
        <img class="paypal-option"
                src="${URLUtils.staticURL('/images/paypal.png')}"
                height="32"
                alt="${paymentOption.name}"
                title="${paymentOption.name}"
        >
    </a>
</li>
