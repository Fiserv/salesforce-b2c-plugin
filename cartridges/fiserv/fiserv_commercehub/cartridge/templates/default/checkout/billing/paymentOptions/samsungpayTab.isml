<li class="nav-item ${pdict.firstActivePaymentMethod === 'SAMSUNGPAY' ? 'active' : ''}" data-method-id="${paymentOption.ID}">
    <a class="nav-link samsungpay-tab ${pdict.firstActivePaymentMethod === 'SAMSUNGPAY' ? 'active' : ''}" data-toggle="tab" href="#samsungpay-content" role="tab">
        <img class="samsungpay-option"
                src="${URLUtils.staticURL('/images/samsungpay.svg')}"
                height="32"
                alt="${paymentOption.name}"
                title="${paymentOption.name}"
        >
    </a>
</li>