<li class="nav-item ${pdict.firstActivePaymentMethod === 'AFFIRM' ? 'active' : ''}" data-method-id="${paymentOption.ID}">
    <a class="nav-link affirm-tab ${pdict.firstActivePaymentMethod === 'AFFIRM' ? 'active' : ''}" data-toggle="tab" href="#affirm-content" role="tab">
        <img class="affirm-option"
                src="${URLUtils.staticURL('/images/affirm.png')}"
                height="32"
                alt="${paymentOption.name}"
                title="${paymentOption.name}"
        >
    </a>
</li>
