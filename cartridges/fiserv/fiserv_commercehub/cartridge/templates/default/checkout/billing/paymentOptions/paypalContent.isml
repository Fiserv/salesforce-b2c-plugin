<isset name="FiservHelper" value="${require('*/cartridge/scripts/utils/fiservHelper')}" scope="pdict" />
<isset name="FrontendConfigRetriever" value="${require('*/cartridge/scripts/utils/commercehubFrontendInitializationData')}" scope="pdict" />
<isset name="chSdkUrl" value="${pdict.FiservHelper.getCommercehubSDK()}" scope="pdict" />

<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-helper.js');
    assets.addJs('/js/fiserv_base/commercehub-sdk-button-adapter.js');
    assets.addJs('/js/fiserv_paypal/commercehub-paypal-button.js');
    assets.addJs('/js/fiserv_paypal/paypal.js');
    assets.addJs(pdict.chSdkUrl);
    assets.addCss('css/fiservScc.css');
</isscript>

<div class="tab-pane paypal-content" id="paypal-content" role="tabpanel">

    <fieldset class="payment-form-fields">
        
        <!--- payment method is PayPal --->
        <input type="hidden" class="form-control"
               name="${pdict.forms.billingForm.paymentMethod.htmlName}"
               value="PAYPAL"
        >

        <div id="fiserv-commercehub-paypal-form-init-container" 
            data-commercehub-initialization-data="${JSON.stringify(pdict.FrontendConfigRetriever.retrieveFrontendInitializationData('PayPal'))}"
            data-commercehub-credentials="${URLUtils.https('Fiserv-Credentials')}"
            data-initial-checkout-stage="${pdict.currentStage}"></div>
    
        <div id="fiserv-commercehub-paypal-form-container">
            <div id="fiserv_commercehub-paypal-button" class="sdc-button"></div>

            <div id="fiserv-paypal-fatal-notice" class="alert alert-danger">
                <p>${Resource.msg('message.error.paypal.fatal','error',null)}</p>            
            </div>
        </div>

        <!--- Hidden input for credit card type --->
        <input id="commercehubOrderIdInputPayPal" type="hidden" name="${pdict.forms.billingForm.fiservCommercehubPaymentFields.commercehubOrderId.htmlName}"/>
    </fieldset>
</div>