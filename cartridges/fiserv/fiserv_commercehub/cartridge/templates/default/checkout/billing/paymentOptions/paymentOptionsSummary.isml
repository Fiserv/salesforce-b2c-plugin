<div class="payment-details">
    <isloop items="${pdict.order.billing.payment.selectedPaymentInstruments}" var="payment" status="status">
        <isif condition="${payment.paymentMethod === 'CREDIT_CARD'}">
            <isinclude template="checkout/billing/paymentOptions/creditCardSummary" />
        <iselseif condition="${payment.paymentMethod === 'GIFT_CARD'}" />
            <isinclude template="checkout/billing/paymentOptions/giftCardSummary" />
        <iselseif condition="${payment.paymentMethod === 'PAYPAL'}" />
            <isinclude template="checkout/billing/paymentOptions/paypalSummary" />
        <iselseif condition="${payment.paymentMethod === 'VENMO'}" />
            <isinclude template="checkout/billing/paymentOptions/venmoSummary" />
        <iselseif condition="${payment.paymentMethod === 'APPLEPAY'}" />
            <isinclude template="checkout/billing/paymentOptions/applepaySummary" />
        </isif>
        <isif condition="${!status.last}">
            <br/>
        </isif>
    </isloop>

    <input type="hidden" class="form-control" id="cardType" name="${pdict.forms.billingForm.creditCardFields.cardType.htmlName}" value="" />
    <input type="hidden" class="form-control cardNumber" id="cardNumber" value="" <isprint value=${pdict.forms.billingForm.creditCardFields.cardNumber.attributes} encoding="off"/>/>
    <select style="display:none;" id="expirationMonth" name="${pdict.forms.billingForm.creditCardFields.expirationMonth.htmlName}">
        <option id="expirationMonthValue" value=""></option>
    </select>
    <select style="display:none;" id="expirationYear" name="${pdict.forms.billingForm.creditCardFields.expirationYear.htmlName}">
        <option id="expirationYearValue" value=""></option>
    </select>
</div>
