<div class="form-group saved-cvv-container" data-uuid="${paymentInstrument.UUID}" data-card-type="${paymentInstrument.creditCardType}">
    <label class="form-control-label" for="sdc-security-code-frame-${paymentInstrument.UUID}">
        ${Resource.msg('field.credit.card.security.code','creditCard',null)}
    </label>
    <div id="sdc-security-code-frame-${paymentInstrument.UUID}" class="sdc-field-frame sdc-text">
        <div id="fiserv_commercehub-security-code-${paymentInstrument.UUID}" class="sdc-field"></div>
        <button type="button" id="sdc-mask-securityCode-${paymentInstrument.UUID}" class="btn sdc-unmasking-icon" aria-label="Toggle CVV visibility"></button>
    </div>
    <div class="invalid-feedback" id="sdc-security-code-invalid-message-${paymentInstrument.UUID}"></div>
</div>

